{
  "framework": "TT-OS Capture Acceptance Framework",
  "schema_version": "1.0.0",
  "spec_part": "35",
  "description": "Single source of truth for capture-quality acceptance. Shared by the Hardware SOP (Part 35), the backend (backend/app/capture_quality.py), quality reports, the reliability envelope (Part 10), provenance (Part 34.AK), and the operator dashboard (Part 32). Documentation and implementation must not diverge: the CSV checklist and example report are generated from this file.",
  "philosophy": "Safety-critical / officiating. Certification is governed by the lowest required sub-score, never by a weighted average. A single mandatory gate in red, critical, or missing state denies the level regardless of all other scores. All thresholds are measurable with explicit units and pass/fail actions.",
  "references": {
    "Part 02": "capture tiers, calibration, multi-camera 3D & synchronisation",
    "Part 10": "reliability envelope, confidence, abstain",
    "Part 12": "data/ML infra, edge-to-cloud pipeline, calibration storage",
    "Part 14": "integrations, audio, broadcast latency",
    "Part 19": "trajectory/Magnus physics, units, court geometry",
    "Part 20": "equipment, ball-vs-table contrast, lighting for the ball",
    "Part 31": "security, officiating network isolation, tamper-evidence",
    "Part 32": "operator dashboard, UX, offline capture",
    "Part 34": "engineering conventions (AK provenance, AL reliability-as-type, AP drift, AS health, BA on-call)",
    "Part 35": "Hardware & Capture SOP (sections A-AJ)"
  },
  "scoring": {
    "method": "min_required_subscore",
    "effective_score": "min(subscores of the mandatory KPIs for the awarded certification level)",
    "overall_score": "mean(subscores of all measured KPIs) -- INFORMATIONAL ONLY, never used for certification",
    "subscore_by_state": { "green": 1.0, "amber": 0.7, "red": 0.3, "critical": 0.0, "missing": 0.0 },
    "gate_rule": "A mandatory KPI in red/critical/missing fails the gate and denies that certification level outright. No averaging can recover a failed gate.",
    "level_award": "Evaluate levels platinum -> gold -> silver -> bronze; award the highest level whose mandatory gates all pass, hard requirements all hold, and effective_score >= the level's min_effective_score. If none pass, certification = fail."
  },
  "dashboard_states": ["green", "amber", "red", "critical"],
  "severities": ["info", "warning", "major", "critical"],
  "capture_tiers": {
    "T1": { "name": "single camera 2D", "unlocks": "2D events, stats, scoreboard, coarse spin" },
    "T2": { "name": "single camera + calibration", "unlocks": "metric placement, better speed/spin" },
    "T3": { "name": "multi-camera true 3D", "unlocks": "true 3D, RPM, real spin" },
    "T3_OFFICIATING": { "name": "multi-camera officiating grade", "unlocks": "decisive officiating (Part 35.T)" }
  },
  "reliability_mapping": {
    "platinum": "verified",
    "gold": "high",
    "silver": "moderate",
    "bronze": "preliminary",
    "fail": "unreliable"
  },
  "certification_levels": {
    "fail": { "rank": 0, "label": "not accepted", "tier": null, "min_effective_score": 0.0, "reliability": "unreliable", "mandatory_kpis": [] },
    "bronze": {
      "rank": 1, "label": "academy", "tier": "T1", "min_effective_score": 0.6, "reliability": "preliminary",
      "mandatory_kpis": ["resolution", "frame_rate", "exposure_lock", "white_balance_lock", "lux", "ball_visibility", "tracking_success", "storage_health", "dropped_frames", "battery", "temperature", "metadata_completeness"]
    },
    "silver": {
      "rank": 2, "label": "production", "tier": "T2", "min_effective_score": 0.7, "reliability": "moderate",
      "mandatory_kpis": ["resolution", "frame_rate", "exposure_lock", "white_balance_lock", "lux", "ball_visibility", "tracking_success", "storage_health", "dropped_frames", "battery", "temperature", "metadata_completeness", "shutter", "motion_blur", "lens_calibration", "reprojection_error_px", "calibration_age", "camera_stability", "lighting_uniformity", "flicker", "color_temperature", "occlusion"]
    },
    "gold": {
      "rank": 3, "label": "competition", "tier": "T3", "min_effective_score": 0.85, "reliability": "high",
      "mandatory_kpis": ["resolution", "frame_rate", "exposure_lock", "white_balance_lock", "lux", "ball_visibility", "tracking_success", "storage_health", "dropped_frames", "battery", "temperature", "metadata_completeness", "shutter", "motion_blur", "lens_calibration", "reprojection_error_px", "calibration_age", "camera_stability", "lighting_uniformity", "flicker", "color_temperature", "occlusion", "synchronization_error", "time_synchronization", "camera_drift", "reconstruction_error_mm", "coverage_volume", "overlap_pct", "glare", "network_latency", "packet_loss", "jitter", "versioned_calibration", "provenance", "environmental_sensors"]
    },
    "platinum": {
      "rank": 4, "label": "officiating", "tier": "T3_OFFICIATING", "min_effective_score": 0.95, "reliability": "verified",
      "mandatory_kpis": ["resolution", "frame_rate", "exposure_lock", "white_balance_lock", "lux", "ball_visibility", "tracking_success", "storage_health", "dropped_frames", "battery", "temperature", "metadata_completeness", "shutter", "motion_blur", "lens_calibration", "reprojection_error_px", "calibration_age", "camera_stability", "lighting_uniformity", "flicker", "color_temperature", "occlusion", "synchronization_error", "time_synchronization", "camera_drift", "reconstruction_error_mm", "coverage_volume", "overlap_pct", "glare", "network_latency", "packet_loss", "jitter", "versioned_calibration", "provenance", "environmental_sensors", "global_shutter", "secure_network_isolation", "frame_accurate_timestamps", "tamper_evidence", "ground_truth_status"],
      "hard_requirements": ["global_shutter", "secure_network_isolation", "frame_accurate_timestamps", "versioned_calibration", "tamper_evidence", "ground_truth_status", "provenance"],
      "requirement_notes": { "synchronization_error": "<= 0.5 ms", "reconstruction_error_mm": "<= 5 mm", "policy": "any failed mandatory KPI denies Platinum immediately; no averaging" }
    }
  },
  "kpis": [
    {
      "id": "resolution", "name": "Resolution", "category": "Camera",
      "description": "Vertical pixel resolution of the recorded stream.",
      "units": "px", "direction": "higher_is_better",
      "threshold": 1080, "warning_threshold": 900, "critical_threshold": 720,
      "pass_condition": ">= 1080 px", "fail_condition": "< 720 px",
      "measurement_method": "stream metadata", "priority": "mandatory",
      "required_tier": "T1", "certification_dependency": ["bronze", "silver", "gold", "platinum"],
      "automatic_fail_action": "block_session_start", "recommended_operator_action": "set camera to >= 1080p",
      "auto_retry_allowed": true
    },
    {
      "id": "frame_rate", "name": "Frame Rate", "category": "Camera",
      "description": "Capture frame rate; ball tracking needs >= 120 fps.",
      "units": "fps", "direction": "higher_is_better",
      "threshold": 60, "warning_threshold": 50, "critical_threshold": 30,
      "pass_condition": ">= 60 fps (>= 120 for Gold/Platinum)", "fail_condition": "< 30 fps",
      "measurement_method": "stream metadata / frame-interval timing", "priority": "mandatory",
      "required_tier": "T1", "certification_dependency": ["bronze", "silver", "gold", "platinum"],
      "automatic_fail_action": "stop_recording", "recommended_operator_action": "raise fps; reduce resolution if bandwidth-limited",
      "auto_retry_allowed": true,
      "certification_thresholds": {
        "gold": { "threshold": 120, "warning_threshold": 100, "critical_threshold": 60 },
        "platinum": { "threshold": 120, "warning_threshold": 120, "critical_threshold": 100 }
      }
    },
    {
      "id": "shutter", "name": "Shutter / Exposure Time", "category": "Camera",
      "description": "Exposure (shutter) time; short shutter limits motion blur.",
      "units": "ms", "direction": "lower_is_better",
      "threshold": 1.0, "warning_threshold": 2.0, "critical_threshold": 4.0,
      "pass_condition": "<= 1.0 ms (1/1000 s)", "fail_condition": "> 4.0 ms",
      "measurement_method": "camera exposure setting", "priority": "mandatory",
      "required_tier": "T2", "certification_dependency": ["silver", "gold", "platinum"],
      "automatic_fail_action": "request_setting_change", "recommended_operator_action": "shorten shutter; add light to compensate",
      "auto_retry_allowed": true
    },
    {
      "id": "motion_blur", "name": "Motion Blur", "category": "Visibility",
      "description": "Ball motion-blur length relative to apparent ball diameter (L = v*t).",
      "units": "ball-diameter", "direction": "lower_is_better",
      "threshold": 1.0, "warning_threshold": 1.5, "critical_threshold": 2.0,
      "pass_condition": "<= 1.0 ball-diameter (<= 0.5 for Gold/Platinum)", "fail_condition": "> 2.0 ball-diameter",
      "measurement_method": "blur-length estimate vs ball diameter on fast frames", "priority": "mandatory",
      "required_tier": "T2", "certification_dependency": ["silver", "gold", "platinum"],
      "automatic_fail_action": "request_setting_change", "recommended_operator_action": "shorten shutter / raise fps / add light",
      "auto_retry_allowed": true,
      "certification_thresholds": {
        "gold": { "threshold": 0.5, "warning_threshold": 0.8, "critical_threshold": 1.0 },
        "platinum": { "threshold": 0.5, "warning_threshold": 0.6, "critical_threshold": 0.8 }
      }
    },
    {
      "id": "exposure_lock", "name": "Exposure Lock", "category": "Camera",
      "description": "Manual exposure is locked for the session (no auto drift).",
      "units": "boolean", "direction": "boolean",
      "threshold": true, "warning_threshold": null, "critical_threshold": null,
      "pass_condition": "locked == true", "fail_condition": "auto-exposure active",
      "measurement_method": "camera control state", "priority": "mandatory",
      "required_tier": "T1", "certification_dependency": ["bronze", "silver", "gold", "platinum"],
      "automatic_fail_action": "request_setting_change", "recommended_operator_action": "disable auto-exposure; lock manual exposure",
      "auto_retry_allowed": true
    },
    {
      "id": "white_balance_lock", "name": "White Balance Lock", "category": "Camera",
      "description": "White balance is locked to a measured colour temperature.",
      "units": "boolean", "direction": "boolean",
      "threshold": true, "warning_threshold": null, "critical_threshold": null,
      "pass_condition": "locked == true", "fail_condition": "auto-WB active",
      "measurement_method": "camera control state", "priority": "mandatory",
      "required_tier": "T1", "certification_dependency": ["bronze", "silver", "gold", "platinum"],
      "automatic_fail_action": "request_setting_change", "recommended_operator_action": "lock WB to measured CCT",
      "auto_retry_allowed": true
    },
    {
